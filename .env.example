VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Set ke "true" untuk login pakai akun lokal (src/lib/mockAccounts.js) tanpa
# Supabase tersambung sama sekali - berguna untuk testing awal.
# Set ke "false" (atau hapus baris ini) sebelum deploy ke production.
VITE_USE_MOCK_AUTH=true
